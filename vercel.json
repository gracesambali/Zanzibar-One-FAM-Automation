{
  "crons": [
    {
      "path": "/api/check-maintenance",
      "schedule": "0 6 * * *"
    }
  ],
  "redirects": [
    { "source": "/login.html", "destination": "/login", "permanent": true },
    { "source": "/dashboard.html", "destination": "/dashboard", "permanent": true },
    { "source": "/asset.html", "destination": "/asset", "permanent": true },
    { "source": "/report.html", "destination": "/report", "permanent": true },
    { "source": "/sensor-monitor.html", "destination": "/sensor-monitor", "permanent": true },
    { "source": "/set-password.html", "destination": "/set-password", "permanent": true },
    { "source": "/unit-portal.html", "destination": "/unit-portal", "permanent": true },
    { "source": "/pharmacy-portal.html", "destination": "/pharmacy-portal", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/login.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/asset", "destination": "/asset.html" },
    { "source": "/report", "destination": "/report.html" },
    { "source": "/sensor-monitor", "destination": "/sensor-monitor.html" },
    { "source": "/set-password", "destination": "/set-password.html" },
    { "source": "/unit-portal", "destination": "/unit-portal.html" },
    { "source": "/pharmacy-portal", "destination": "/pharmacy-portal.html" }
  ],
  "headers": [
    { "source": "/login", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/login.html", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/dashboard", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/dashboard.html", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/asset", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/asset.html", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/sensor-monitor", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/sensor-monitor.html", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/unit-portal", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/unit-portal.html", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/pharmacy-portal", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/pharmacy-portal.html", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/set-password", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/set-password.html", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
